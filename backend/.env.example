# =====================================================================
# iCelera · Backend — copie para ".env" e preencha. NUNCA versionar o .env
# Todas as credenciais vivem SOMENTE aqui (nunca no frontend).
# =====================================================================
PORT=3000

# Origem do frontend (CORS). Se servir o frontend por este mesmo servidor, pode deixar vazio.
FRONTEND_ORIGIN=http://localhost:3000

# Segredo para assinar os tokens de login (mínimo 32 caracteres aleatórios).
JWT_SECRET=

# ---- Autentique ----------------------------------------------------
# Token de API gerado no painel do Autentique (Chaves de API). NÃO fornecido — preencher.
AUTENTIQUE_API_TOKEN=
AUTENTIQUE_API_URL=https://api.autentique.com.br/v2/graphql
# true = documentos de teste (sandbox, sem validade jurídica). Use false somente em produção.
AUTENTIQUE_SANDBOX=true
# Segredo do endpoint de webhook cadastrado no painel do Autentique (para validar X-Autentique-Signature).
AUTENTIQUE_WEBHOOK_SECRET=

# ---- n8n (opcional) ------------------------------------------------
# Token compartilhado: o n8n envia no header X-Internal-Token ao chamar /api/internal/signature-events.
INTERNAL_WEBHOOK_TOKEN=

# ---- Usuários iniciais (criados no 1º start, se o banco estiver vazio) ----
# O e-mail do Coordenador DEVE ser o e-mail real que assina no Autentique.
SEED_TECNICO_NAME=
SEED_TECNICO_EMAIL=
SEED_TECNICO_PASSWORD=
SEED_COORDENADOR_NAME=
SEED_COORDENADOR_EMAIL=
SEED_COORDENADOR_PASSWORD=
